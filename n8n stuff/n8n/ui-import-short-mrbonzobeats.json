      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "link",
              "value": "={{ $json.link }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "shortTitle",
              "value": "={{ $json.shortTitle || (() => { const suffix = ' #Shorts'; const raw = String($json.title || 'New release').replace(/#Shorts/ig, '').trim(); let t = raw; const q = raw.match(/[\"“](.+?)[\"”]/); let name = q && q[1].trim() ? q[1].trim() : raw; if (!q) { name = name.replace(/\\s*\\|.*$/, ''); name = name.replace(/^\\[free\\]\\s*/i, ''); name = name.replace(/\\b(old school|boom bap|instrumental hip hop|type beat|free)\\b/ig, ' '); name = name.replace(/\\[[^\\]]*\\]/g, ' '); name = name.replace(/\\s+/g, ' ').replace(/^[\\s\\-–—|]+|[\\s\\-–—|]+$/g, ''); } name = name.replace(/\\s*type beat\\s*$/i, '').trim(); name = (name || 'Beat').slice(0, 40).replace(/[\\s\\-–—|]+$/, ''); t = (name || 'Beat') + ' Type Beat'; const keep = 70 - suffix.length; if (t.length > keep) t = t.slice(0, keep).replace(/[\\s\\-–,|]+$/,''); return (t || 'New release') + suffix; })() }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "shortDescription",
              "value": "={{ $json.shortDescription || (() => { const title = String($json.title || \"New type beat by Mr. Bonzo\"); const link = String($json.link || ''); const vid = (link.match(/[?&]v=([^&]+)/) || link.match(/\\/shorts\\/([^/?]+)/) || [null,''])[1]; const url = vid ? ('https://www.youtube.com/watch?v=' + vid) : link; return title + '\\n\\nWatch the full track: ' + url + '\\n\\n' + \"#Shorts #typebeat #mrbonzo #instrumental\"; })() }}",
              "type": "string"
            },
            {
              "id": "panel-requestId",
              "name": "requestId",
              "value": "={{ $json.requestId || '' }}",
              "type": "string"
            },
            {
              "id": "panel-skipWait",
              "name": "skipWait",
              "value": "={{ $json.skipWait === true }}",
              "type": "boolean"
            },
            {
              "id": "panel-clipStart",
              "name": "clipStart",
              "value": "={{ $json.clipStart || '' }}",
              "type": "string"
            },
            {
              "id": "panel-clipSeconds",
              "name": "clipSeconds",
              "value": "={{ ($json.clipSeconds === undefined || $json.clipSeconds === null || $json.clipSeconds === '') ? '' : String($json.clipSeconds) }}",
              "type": "string"
            },
            {
              "id": "panel-hookSet",
              "name": "hookSet",
              "value": "={{ $json.hookSet === true }}",
              "type": "boolean"
            },
            {
              "id": "panel-ctaSet",
              "name": "ctaSet",
              "value": "={{ $json.ctaSet === true }}",
              "type": "boolean"
            },
            {
              "id": "panel-hookText",
              "name": "hookText",
              "value": "={{ $json.hookText || '' }}",
              "type": "string"
            },
            {
              "id": "panel-ctaText",
              "name": "ctaText",
              "value": "={{ $json.ctaText || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
