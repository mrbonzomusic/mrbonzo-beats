    {
      "id": "05d1aad8-e79c-4ad0-8582-2cd6e32c3819",
      "name": "Pick posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = $now.setZone('Europe/Athens');\nconst week = now.weekNumber;\nconst day = now.day;\nconst month = now.month;\nconst raw = $input.first().json || {};\nconst input = (raw.body && typeof raw.body === 'object') ? Object.assign({}, raw, raw.body) : raw;\nconst testPage = String(input.testPage || '');\nconst pagesIn = Array.isArray(input.pages) ? input.pages.map(String).filter(Boolean) : [];\nconst luxonDay = now.weekday;\nconst panelDay = luxonDay === 7 ? 0 : luxonDay;\nif (!pagesIn.length && !testPage && panelDay !== 4) return [];\nconst customCaption = String(input.caption || '');\nconst image = String(input.image || \"https://mrbonzo-beats.pages.dev/og-image-v2.jpg\");\nconst link = String(input.link || \"https://mrbonzo-beats.pages.dev/\");\nconst pools = {\"mrbonzo\": [\"Το επίσημο site του Mr. Bonzo είναι εδώ! Ανακάλυψε τα τελευταία beats, drum kits και τις νέες κυκλοφορίες. Boom bap, trap και κορυφαία παραγωγή σε ένα μέρος.\"], \"studio\": [\"Το επίσημο site του Mr. Bonzo είναι εδώ! Ανακάλυψε τα τελευταία beats, drum kits και τις νέες κυκλοφορίες. Boom bap, trap και κορυφαία παραγωγή σε ένα μέρος.\"]};\nconst rules = {\"mrbonzo\": \"twice_month\", \"studio\": \"day_15_21\"};\nconst line = (text) => {\n  const t = String(text || '').trim();\n  if (!t) return link;\n  if (/https?:\\/\\//i.test(t)) return t;\n  return t + String.fromCharCode(10) + link;\n};\nconst want = (page) => {\n  if (pagesIn.length) return pagesIn.includes(page);\n  if (testPage) return testPage === page;\n  const rule = rules[page] || 'always';\n  if (rule === 'day_1_7') return day <= 7;\n  if (rule === 'day_15_21') return day >= 15 && day <= 21;\n  if (rule === 'twice_month') return day <= 7 || (day >= 15 && day <= 21);\n  return true;\n};\nconst captionFor = (page) => {\n  if (customCaption) return line(customCaption);\n  const pool = pools[page] || [''];\n  const idx = (rules[page] === 'always' || rules[page] === 'twice_month') ? week : Math.max(0, month - 1);\n  return line(pool[idx % pool.length] || pool[0] || '');\n};\nconst posts = [];\nfor (const page of Object.keys(pools)) {\n  if (!want(page)) continue;\n  posts.push({ json: { page, caption: captionFor(page), image, link } });\n}\nreturn posts;\n"
      }
    },
