# Spotify Web API (preferred for Latest Releases at build time)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional — defaults to artist id parsed from src/config/links.ts socialLinks.spotify
# SPOTIFY_ARTIST_ID=5ziH2Z9Gl3M1FhcYvrLHpv

# Optional RSS fallback if API credentials are missing
# RELEASES_RSS_URL=

# GitHub Actions daily rebuild (not an Astro env var): add repo secret
# CLOUDFLARE_PAGES_DEPLOY_HOOK = Cloudflare Pages → Settings → Deploy hooks URL

# Newsletter (Cloudflare Pages Function functions/api/subscribe.js)
# Local homelab cannot be reached from Pages until you put Plunk on a public URL
# (Cloudflare Tunnel). Then set these in Pages → Settings → Environment variables.
# Local API (homelab). Pages uses a public tunnel URL in production secrets.
# PLUNK_API_URL=https://plunk-api.homelab.lan
# PLUNK_SECRET_KEY=

