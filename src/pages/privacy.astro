---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import en from "../i18n/en";

const canonicalUrl = "https://mrbonzo-beats.pages.dev/privacy";
const description = "Privacy Policy for the Mr. Bonzo beat store. Controller: Alexandros Pilatos (Mr. Bonzo), Athens.";
const copy = en.legal;
---

<BaseLayout title={copy.privacyPageTitle} titleI18n="legal.privacyPageTitle" description={description} canonicalUrl={canonicalUrl}>
  <article class="mx-auto max-w-3xl px-2 pb-8 pt-16 sm:px-4 sm:pt-20">
    <p class="eyebrow-hero-label">Mr. Bonzo</p>
    <h1 class="display-heading mt-4 text-4xl font-black uppercase text-white sm:text-5xl" data-i18n="legal.privacyH1">{copy.privacyH1}</h1>
    <p class="mt-4 text-xs font-bold uppercase tracking-wide text-fuchsia-300/70" data-i18n="legal.updated">{copy.updated}</p>

    <div class="mt-10 space-y-10 text-base leading-relaxed text-gray-300">
      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.controllerHeading">{copy.controllerHeading}</h2>
        <p class="mt-3" data-i18n="legal.controllerP">{copy.controllerP}</p>
        <p class="mt-3" data-i18n="legal.html.privacyContact" set:html={copy.html.privacyContact}></p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.dataHeading">{copy.dataHeading}</h2>
        <p class="mt-3" data-i18n="legal.dataIntro">{copy.dataIntro}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li data-i18n="legal.dataEmail">{copy.dataEmail}</li>
          <li data-i18n="legal.dataSocial">{copy.dataSocial}</li>
          <li data-i18n="legal.html.privacyDataOrders" set:html={copy.html.privacyDataOrders}></li>
          <li data-i18n="legal.dataLang">{copy.dataLang}</li>
          <li data-i18n="legal.dataAnalytics">{copy.dataAnalytics}</li>
          <li data-i18n="legal.dataIp">{copy.dataIp}</li>
        </ul>
        <p class="mt-3" data-i18n="legal.dataId">{copy.dataId}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.whyHeading">{copy.whyHeading}</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li data-i18n="legal.why1">{copy.why1}</li>
          <li data-i18n="legal.why2">{copy.why2}</li>
          <li data-i18n="legal.why3">{copy.why3}</li>
          <li data-i18n="legal.why4">{copy.why4}</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.basesHeading">{copy.basesHeading}</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li data-i18n="legal.base1">{copy.base1}</li>
          <li data-i18n="legal.base2">{copy.base2}</li>
          <li data-i18n="legal.base3">{copy.base3}</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.soldHeading">{copy.soldHeading}</h2>
        <p class="mt-3" data-i18n="legal.soldP">{copy.soldP}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.processorsHeading">{copy.processorsHeading}</h2>
        <p class="mt-3" data-i18n="legal.processorsIntro">{copy.processorsIntro}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li data-i18n="legal.proc1">{copy.proc1}</li>
          <li data-i18n="legal.proc2">{copy.proc2}</li>
          <li data-i18n="legal.proc3">{copy.proc3}</li>
          <li data-i18n="legal.proc4">{copy.proc4}</li>
          <li data-i18n="legal.proc5">{copy.proc5}</li>
        </ul>
        <p class="mt-3" data-i18n="legal.noDb">{copy.noDb}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.retainHeading">{copy.retainHeading}</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li data-i18n="legal.retain1">{copy.retain1}</li>
          <li data-i18n="legal.retain2">{copy.retain2}</li>
          <li data-i18n="legal.retain3">{copy.retain3}</li>
          <li data-i18n="legal.retain4">{copy.retain4}</li>
          <li data-i18n="legal.retain5">{copy.retain5}</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.rightsHeading">{copy.rightsHeading}</h2>
        <p class="mt-3" data-i18n="legal.rightsP1">{copy.rightsP1}</p>
        <p class="mt-3" data-i18n="legal.html.privacyRightsEmail" set:html={copy.html.privacyRightsEmail}></p>
        <p class="mt-3" data-i18n="legal.html.privacyRightsHdpa" set:html={copy.html.privacyRightsHdpa}></p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.childrenHeading">{copy.childrenHeading}</h2>
        <p class="mt-3" data-i18n="legal.childrenP">{copy.childrenP}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.termsHeading">{copy.termsHeading}</h2>
        <p class="mt-3" data-i18n="legal.html.privacyTerms" set:html={copy.html.privacyTerms}></p>
      </section>
    </div>
  </article>
  <SiteFooter />
</BaseLayout>
