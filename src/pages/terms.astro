---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import en from "../i18n/en";

const canonicalUrl = "https://mrbonzo-beats.pages.dev/terms";
const description = "Terms of Service for Mr. Bonzo beats, sound kits, and licenses. Operated by Alexandros Pilatos.";
const copy = en.legal;
---

<BaseLayout title={copy.termsPageTitle} titleI18n="legal.termsPageTitle" description={description} canonicalUrl={canonicalUrl}>
  <article class="mx-auto max-w-3xl px-2 pb-8 pt-16 sm:px-4 sm:pt-20">
    <p class="eyebrow-hero-label">Mr. Bonzo</p>
    <h1 class="display-heading mt-4 text-4xl font-black uppercase text-white sm:text-5xl" data-i18n="legal.termsH1">{copy.termsH1}</h1>
    <p class="mt-4 text-xs font-bold uppercase tracking-wide text-fuchsia-300/70" data-i18n="legal.updated">{copy.updated}</p>

    <div class="mt-10 space-y-10 text-base leading-relaxed text-gray-300">
      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.whoHeading">{copy.whoHeading}</h2>
        <p class="mt-3" data-i18n="legal.html.termsWho" set:html={copy.html.termsWho}></p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.sellsHeading">{copy.sellsHeading}</h2>
        <p class="mt-3" data-i18n="legal.html.termsSellsP1" set:html={copy.html.termsSellsP1}></p>
        <p class="mt-3" data-i18n="legal.sellsP2">{copy.sellsP2}</p>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li data-i18n="legal.leaseBasic">{copy.leaseBasic}</li>
          <li data-i18n="legal.leasePremium">{copy.leasePremium}</li>
          <li data-i18n="legal.leaseExclusive">{copy.leaseExclusive}</li>
        </ul>
        <p class="mt-3" data-i18n="legal.sellsP3">{copy.sellsP3}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.licenseHeading">{copy.licenseHeading}</h2>
        <p class="mt-3" data-i18n="legal.licenseP1">{copy.licenseP1}</p>
        <p class="mt-3" data-i18n="legal.licenseP2">{copy.licenseP2}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.ageHeading">{copy.ageHeading}</h2>
        <p class="mt-3" data-i18n="legal.ageP">{copy.ageP}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.useHeading">{copy.useHeading}</h2>
        <p class="mt-3" data-i18n="legal.useP">{copy.useP}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.payHeading">{copy.payHeading}</h2>
        <p class="mt-3" data-i18n="legal.payP1">{copy.payP1}</p>
        <p class="mt-3" data-i18n="legal.payP2">{copy.payP2}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.claimsHeading">{copy.claimsHeading}</h2>
        <p class="mt-3" data-i18n="legal.claimsP1">{copy.claimsP1}</p>
        <p class="mt-3" data-i18n="legal.claimsP2">{copy.claimsP2}</p>
        <p class="mt-3" data-i18n="legal.claimsP3">{copy.claimsP3}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.liabilityHeading">{copy.liabilityHeading}</h2>
        <p class="mt-3" data-i18n="legal.liabilityP">{copy.liabilityP}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.lawHeading">{copy.lawHeading}</h2>
        <p class="mt-3" data-i18n="legal.lawP">{copy.lawP}</p>
      </section>

      <section>
        <h2 class="text-xl font-black uppercase tracking-wide text-white" data-i18n="legal.privacyHeading">{copy.privacyHeading}</h2>
        <p class="mt-3" data-i18n="legal.html.termsPrivacy" set:html={copy.html.termsPrivacy}></p>
      </section>
    </div>
  </article>
  <SiteFooter />
</BaseLayout>
